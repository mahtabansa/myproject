  <% layout("/layouts/boilerplate") %>
  <script>
    const listing =<%- JSON.stringify(elm) %>;
</script>
<style>
    .img_listing {
    height: 20rem;
  }

  #map {
    display: block !important;
    height: 20rem; 
    border-radius: 1rem;
  }
</style>

<div class="container flex justify-content-center align-items-center py-5">
   <div class="col-12 col-sm-8 col-md-8 col-lg-8  pr-2">
     <div class="row  ">
     
        
        <div class="col-12 col-sm-8 col-md-8 col-lg-12 rounded
       "  >
           <h1 class="py-5"><%= elm.title %></h1>
            <div class="col-sm-8 col-md-10 col-lg-10 mr-3" >
              <img style="width:90%;"  src="<%= elm.image.url %>"  
              class="border rounded-3 img_listing" alt="house-image">
            </div>  

          <div class=" col-sm-8 col-md-8 col-lg-8 " >
              <p class="pt-3"><i>Ownyed by <%= elm.owner.username %></i></p>
              <p><%= elm.description %></p>
              <p><%= elm.country %>  , <%= elm.location %></p>
              <p class="card-text">&#8377;<%= elm.price.toLocaleString("en-IN")%>/night</p>
          </div>
        </div>

      
          <% if(currUser && currUser._id.equals(elm.owner._id)) { %> 
          <div class="allbtns">
                <form 
                  method="GET" action="/listings/<%= elm._id %>/edit">
                   <button class="btn btn-dark col-1 edit-btn">Edit</button>
                </form>
                <form  method="POST" action="/listings/<%= elm._id %>?_method=DELETE">
                  <button class= "btn btn-dark  delete-btn" >Delete</button>
                </form>
        </div>
     <%  }  %> 

      <div class=" col-12 col-sm-8 col-md-8 col-lg-8 pb-5" >
       <hr>
       <% if(currUser) { %>
            <h4>Leave Review</h4>
          <form action="/listings/<%= elm.id %>/reviews" method="POST" class="needs-validation" novalidate >
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" 
                  value="1" aria-label="No rating" />
                  <input type="radio" id="second-rate1" name ="review[rating]" value="1"  />
                  <label for="second-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="second-rate2" name ="review[rating]" value="2" />
                  <label for="second-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="second-rate3" name ="review[rating]" value="3" />
                  <label for="second-rate3" title="Average">3 stars</label>
                  <input type="radio" id="second-rate4" name ="review[rating]" value="4" />
                  <label for="second-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="second-rate5" name ="review[rating]" value="5" />
                  <label for="second-rate5" title="Amazing">5 stars</label>
                </fieldset>

                <div class=" col-12 col-sm-8 col-md-12 col-lg-8  mb-3" id="comment">
                    <label for="comment" class="form-label" >Comment</label>
                    <textarea  type ="text" name= "review[comment]" id="comment"
                    rows="3" cols="50" class="form-control" required></textarea>
                    <div class="invalid-feedback">please submit valid comment</div>
                </div>
              <button class="btn btn-outline-dark mb-3" >Submit</button>
            </form>
      </div>
        <% } %>
    </div>  

       <div class="container pb-5 ">
          <div class="row g-4 "> 
            <% for(review of elm.reviews) { %> 
                  <div class="col-8 col-sm-8 col-md-4 col-lg-4 ">
                    <div class="card p-3 ">
                
                      <h5 class="card-title fs-4 "><i>@<%= review.author.username %></i></h5>
                      <p class="card-text"><%= review.comment  %></p>
                      <span class="starability-result " style="font-size:small;" data-rating="<%= review.rating %>"></span>

                   
                    <form  method="POST" class="btn" 
                      action="/listings/<%= elm._id %>/reviews/<%= review._id %>?_method=DELETE" >
                      <button class="btn btn-sm" style="color: rgb(219, 49, 49); background-color: 
                      rgb(238, 229, 229);">Delete</button>
                    </form>
                  </div>
                </div>
              <% } %>
           </div>
        </div>   
      
      <div class="col-12 col-sm-8 col-md-8 col-lg-12 my-3" >
         <div id="map" ></div>  
      </div>

    </div>
    
    </div>

    <script src="/js/map.js"></script>

     <script>
        
         
        const mapToken = '<%= mapToken %>';

        initializeMap( mapToken);

    </script>
   

